    "paths": {
        "/api/announcements": {
            "get": {
                "tags": [
                    "Annonces"
                ],
                "summary": "Liste des annonces disponibles",
                "operationId": "71c08f9cc8bee71c81626251da258590",
                "responses": {
                    "200": {
                        "description": "Liste récupérée avec succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Announcement"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Annonces"
                ],
                "summary": "Crée une annonce",
                "description": "security={{ \"bearerAuth\": {} }},",
                "operationId": "dc2f49bef808056e16e168f71b8830ec",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "title",
                                    "category_id",
                                    "operation_type",
                                    "state",
                                    "exchange_location_address",
                                    "exchange_location_lng",
                                    "exchange_location_lat"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Titre de l'annonce"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Une description"
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "operation_type": {
                                        "type": "string",
                                        "example": "vente"
                                    },
                                    "state": {
                                        "type": "string",
                                        "example": "neuf"
                                    },
                                    "price": {
                                        "type": "string",
                                        "example": "50000"
                                    },
                                    "exchange_location_address": {
                                        "type": "string",
                                        "example": "Kinshasa, Gombe"
                                    },
                                    "exchange_location_lng": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 15.308889
                                    },
                                    "exchange_location_lat": {
                                        "type": "number",
                                        "format": "float",
                                        "example": -4.325
                                    },
                                    "created_by": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "photo": {
                                        "description": "Image de l'annonce (jpg, jpeg, png, gif, 2Mo max.)",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Annonce créée avec succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Announcement"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                }
            }
        },
